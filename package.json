{
  "name": "mantis-bug-tracker-action",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/voidentropy/mantis-bug-tracker-action.git"
  },
  "homepage": "https://github.com/voidentropy/mantis-bug-tracker-action/#readme",
  "version": "1.3.10",
  "description": "Mantis Bug Tracker Action",
  "main": "lib/main.js",
  "license": "MIT",
  "author": {
    "name": "Marc Jorge Gonzalez",
    "email": "mjorge@voidentropy.com"
  },
  "keywords": [
    "GitHub",
    "Actions",
    "JavaScript",
    "MantisBT",
    "Bug Tracker"
  ],
  "bugs": {
    "url": "https://github.com/voidentropy/mantis-bug-tracker-action/issues"
  },
  "scripts": {
    "build": "tsc",
    "format": "prettier --write '**/*.ts'",
    "format-check": "prettier --check '**/*.ts'",
    "lint": "eslint --fix",
    "package": "ncc build --source-map --license licenses.txt lib/src/main.js",
    "test": "NODE_OPTIONS=--experimental-vm-modules jest",
    "all": "npm run build && npm run format && npm run package && npm test"
  },
  "dependencies": {
    "@actions/core": "^1.10.1",
    "@actions/github": "^9.1.1",
    "@typescript/typescript6": "^6.0.2",
    "axios": "^1.20.0",
    "lodash": "^4.18.1",
    "markdown-to-txt": "^2.0.1",
    "sanitize-html": "^2.18.0"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.7",
    "@eslint/js": "^10.0.1",
    "@types/jest": "^30.0.0",
    "@types/node": "^26.6.4",
    "@types/sanitize-html": "^2.16.2",
    "@typescript-eslint/eslint-plugin": "^8.71.0",
    "@typescript-eslint/parser": "^8.71.0",
    "@vercel/ncc": "^0.45.0",
    "eslint": "^10.12.0",
    "eslint-plugin-github": "^6.1.2",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-jest": "^29.16.6",
    "eslint-plugin-n": "^18.4.1",
    "globals": "^17.13.0",
    "jest": "^30.5.2",
    "js-yaml": "^5.4.2",
    "prettier": "^3.9.9",
    "ts-jest": "^29.4.14",
    "typescript": "^6.0.3"
  },
  "engines": {
    "node": ">=18"
  }
